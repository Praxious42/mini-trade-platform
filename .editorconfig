# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{java,xml,properties,yml,yaml}]
indent_size = 4

[*.{md,txt}]
trim_trailing_whitespace = false
max_line_length = off

[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf

[*.{js,ts,jsx,tsx,json,css,html}]
indent_size = 2

# Keep IDE/project files unchanged
[*.iml]
trim_trailing_whitespace = false

