FROM postgres:15

ARG POSTGRES_USER=postgres
ARG POSTGRES_PASSWORD=postgres
ARG POSTGRES_DB=mintrade-portfolio

ENV POSTGRES_USER=${POSTGRES_USER}
ENV POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
ENV POSTGRES_DB=${POSTGRES_DB}

# Copy local init scripts into the image so they run on first initialization
COPY ../initdb.d /docker-entrypoint-initdb.d/

RUN chmod -R 755 /docker-entrypoint-initdb.d || true

HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=5 \
  CMD pg_isready -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" || exit 1

EXPOSE 5432

# To build:
#   cd db-migrations/docker
#   docker build -f postgres/Dockerfile.dev -t mintrade-postgres-portfolio:dev .
# To run:
#   docker run --rm -d --name mintrade-postgres-portfolio -p 1235:5432 -e POSTGRES_PASSWORD=password -e POSTGRES_DB=mintrade-portfolio -v mintrade_pgdata_portfolio:/var/lib/postgresql/data mintrade-postgres-portfolio:dev

